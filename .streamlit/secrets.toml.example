# Copie este arquivo para .streamlit/secrets.toml (que NÃO vai para o Git)
# e troque os hashes. Para gerar o hash de uma senha:
#   python -m functions.auth "minha-senha"
# No Streamlit Cloud, cole este conteúdo em Settings > Secrets.

[usuarios.admin]
nome = "Administrador"
tipo = "admin"
senha_hash = "COLE_AQUI_O_HASH"

[usuarios.cliente01]
nome = "Farmacêutica XPTO"
tipo = "cliente"
senha_hash = "COLE_AQUI_O_HASH"

# Banco de dados (Supabase). Sem esta seção, o app usa o SQLite local,
# que no Streamlit Cloud é apagado a cada reinício.
# No Supabase: botão "Connect" > "Session pooler" > copie a URI e troque
# [YOUR-PASSWORD] pela senha do banco.
[database]
url = "postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
