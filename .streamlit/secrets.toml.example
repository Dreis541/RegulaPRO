# Copie este arquivo para .streamlit/secrets.toml (que NÃO vai para o Git)
# e troque os hashes. Para gerar o hash de uma senha:
#   python -m functions.auth "minha-senha"
# No Streamlit Cloud, cole este conteúdo em Settings > Secrets.

[usuarios.admin]
nome = "Administrador"
tipo = "admin"
senha_hash = "COLE_AQUI_O_HASH"

[usuarios.cliente01]
nome = "Farmacêutica XPTO"
tipo = "cliente"
senha_hash = "COLE_AQUI_O_HASH"
